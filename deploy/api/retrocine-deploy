#!/usr/bin/env bash
# Выкладка сервера kinō на api.sohimazdai.ru. Вызывается через sudo из deploy/deploy.sh.
#   retrocine-deploy <rev>   — архив коммита (tar.gz) на stdin
#   retrocine-deploy --status | --logs [N] | --rollback
set -euo pipefail
ROOT=/opt/retrocine; REL=$ROOT/releases; LOG=/var/log/retrocine-deploy.log
health(){ for i in $(seq 1 30); do curl -fsS -m 2 http://127.0.0.1:8090/health >/dev/null 2>&1 && return 0; sleep 0.5; done; return 1; }
case "${1:-}" in
  --status)
    echo "Текущий релиз: $(readlink $ROOT/current || echo нет)"
    systemctl --no-pager --lines=0 status retrocine-sync livekit caddy | grep -E "●|Active:" || true
    curl -fsS -m 2 http://127.0.0.1:8090/health && echo
    echo "Релизы:"; ls -1t $REL | head -5; echo "Журнал деплоя:"; tail -n 15 $LOG 2>/dev/null || true; exit;;
  --logs) journalctl -u retrocine-sync -n "${2:-100}" --no-pager; exit;;
  --rollback)
    cur=$(readlink $ROOT/current || true)
    prev=$(ls -1dt $REL/*/ | sed 's:/$::' | grep -vx "$cur" | head -1)
    [ -n "$prev" ] || { echo "Некуда откатывать"; exit 1; }
    ln -sfn "$prev" $ROOT/current.new && mv -T $ROOT/current.new $ROOT/current
    systemctl restart retrocine-sync; health && echo "Откатил на $prev" || { echo "Сервер не отвечает после отката"; exit 1; }
    exit;;
esac
REV="${1:?нужен номер коммита}"
[[ "$REV" =~ ^[0-9a-f]{4,40}$ ]] || { echo "Плохой коммит: $REV"; exit 1; }
exec 9>/run/retrocine-deploy.lock; flock -n 9 || { echo "Уже идёт другой деплой"; exit 1; }
exec > >(tee -a $LOG) 2>&1
echo "== $(date -Is) деплой $REV"
DIR=$REL/$(date +%Y%m%d-%H%M%S)-$REV
mkdir -p "$DIR"; trap 'rm -rf "$DIR"' ERR
tar -xzf - -C "$DIR"
cd "$DIR/server" && npm ci --omit=dev --no-audit --no-fund --silent
node --check "$DIR/server/src/index.js"
echo "$REV" > "$DIR/server/RELEASE"
chown -R root:root "$DIR"; chmod -R a+rX "$DIR"
prev=$(readlink $ROOT/current || true)
ln -sfn "$DIR" $ROOT/current.new && mv -T $ROOT/current.new $ROOT/current
trap - ERR
systemctl restart retrocine-sync
if health; then echo "OK: $(curl -fsS http://127.0.0.1:8090/health)"
else
  echo "Сервер не ответил, возвращаю $prev"
  [ -n "$prev" ] && ln -sfn "$prev" $ROOT/current.new && mv -T $ROOT/current.new $ROOT/current && systemctl restart retrocine-sync
  exit 1
fi
ls -1dt $REL/*/ | tail -n +6 | xargs -r rm -rf
